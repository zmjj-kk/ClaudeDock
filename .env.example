# KamaClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
KAMA_HOST=127.0.0.1
KAMA_PORT=7437

# ── Logging ───────────────────────────────────────────────────
KAMA_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
KAMA_LOG_FILE=~/.kama/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
KAMA_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# KAMA_CONFIG=~/.kama/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# KAMA_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# KAMA_MAX_STEPS=20

# IPC 本地自动创建 0600 凭证；Compose/远程客户端需显式设置同一随机密钥
# KAMA_IPC_TOKEN=<python -c 'import secrets; print(secrets.token_urlsafe(32))'>
# KAMA_ALLOW_REMOTE=1  # 仅用于 loopback 发布的容器或经过 TLS 代理的受控网络
# 默认不记录完整 LLM 载荷
KAMA_TRACE_INCLUDE_LLM_PAYLOAD=0

# 公网或跨主机 IPC：配置服务端证书，客户端验证受信 CA
# KAMA_TLS_CERT=/path/server.crt
# KAMA_TLS_KEY=/path/server.key
# KAMA_TLS_CA=/path/ca.crt
# KAMA_TLS_ENABLE=1

# 并发与合并预算（默认值；TOML [runtime] 支持同名字段）
# KAMA_RUNTIME_MAX_RUNS=8
# KAMA_RUNTIME_MAX_JOBS=32
# KAMA_RUNTIME_MAX_LLM_REQUESTS=8
# KAMA_RUNTIME_MAX_TOOL_REQUESTS=16
# KAMA_RUNTIME_RUN_TIMEOUT_S=1800
# KAMA_RUNTIME_MAX_TOKENS=1000000
# KAMA_RUNTIME_MAX_COST_USD=0
# Compose 私有向量服务必须使用独立凭证
# QDRANT_API_KEY=<另一个随机凭证>

# Context engineering uses [compaction] TOML settings; see
# docs/production/context-compaction.example.toml and context-upgrade-runbook.md.
# New flags are not environment variables and remain off until validation.
